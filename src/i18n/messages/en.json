  "aboutPage": {
    "title": "About Knesset Insight",
    "missionTitle": "Our Mission",
    "missionText": "Knesset Insight is a civic-tech platform dedicated to making Israeli parliamentary data accessible to the public. We believe that parliamentary transparency is a cornerstone of a healthy democracy, and every citizen deserves a simple, accessible tool to follow their elected representatives.",
    "whatWeDoTitle": "What We Do",
    "whatWeDoItems": {
      "members": "Track MK activity — votes, legislative initiatives, committee attendance",
      "votes": "Present all plenary votes with breakdowns by faction, coalition and opposition",
      "legislation": "Display the full legislative pipeline — from initial proposal to official publication",
      "data": "Transform raw data into insights using visualizations and artificial intelligence",
      "transparency": "Enable the public to follow, compare and understand parliamentary processes"
    },
    "valuesTitle": "Our Values",
    "values": {
      "transparency": "Transparency",
      "transparencyDesc": "All our data comes from public, open sources. Our code is open to everyone.",
      "accessibility": "Accessibility",
      "accessibilityDesc": "The platform is available in Hebrew, English, Arabic and Russian, with full RTL and WCAG 2.1 support.",
      "nonPartisan": "Non-Partisan",
      "nonPartisanDesc": "We are not affiliated with any political party or movement. The data speaks for itself.",
      "openSource": "Open Source",
      "openSourceDesc": "All platform code is open on GitHub under the GNU AGPLv3 license. Contributions are welcome!"
    },
    "techTitle": "Technology",
    "techText": "The platform is built with Next.js, React, TypeScript and Tailwind CSS. Data is stored in Supabase (PostgreSQL) with Drizzle ORM. Automatic syncing with the Knesset API and Open Knesset runs every few hours."
  },
