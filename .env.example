# ================= App =================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=כנסת אינסייט

# ================= Supabase =================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ================= Database =================
DATABASE_URL=

# ================= Redis =================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================= AI =================
# Gemini
GEMINI_API_KEY=

# Anthropic (optional)
CLAUDE_API_KEY=

# Embeddings: 'gemini'
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# AI Rate Limits
AI_DAILY_CHAT_LIMIT=20

# ================= i18n =================
# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=he,en,ar,ru
NEXT_PUBLIC_DEFAULT_LOCALE=he

# ================= Rate Limiting =================
RATE_LIMIT_ANON=60
RATE_LIMIT_AUTH=200

# ================= Knesset Data Sources =================
KNESSET_ODATA_BASE_URL=https://knesset.gov.il/Odata
OKNESSET_DATA_URL=https://production.oknesset.org/pipelines/data
BUDGET_API_URL=https://next.obudget.org/api

# ================= Sync Schedule (cron expressions) =================
SYNC_ODATA_CRON=0 */6 * * *
SYNC_OKNESSET_CRON=0 3 * * *
SYNC_BUDGET_CRON=0 2 * * 5

# ================= Trigger.dev =================
TRIGGER_SECRET_KEY=

# ================= PWA =================
NEXT_PUBLIC_PWA_ENABLED=true

# ================= Bug Report → GitHub =================
# GitHub Personal Access Token with 'repo' scope (required to create issues)
GITHUB_BUG_REPORT_TOKEN=
# Override repo owner/name (defaults: Yedidya10 / knesset-insight)
# BUG_REPORT_GITHUB_OWNER=Yedidya10
# BUG_REPORT_GITHUB_REPO=knesset-insight
